; Source: psyche-belief 738727d23ec9e9cc6f37b018f428eee5c6cee057, vision/sema-v0.md
; Pending the living: Sema v0 schema packet ruled by Psyche core Fable, inferred.
Library
[]
[ Document.Vector<Block>
  Section.{ Title Vector<Block> }           ; a heading and what is under it
  Block.[ Statement.Text                    ; a paragraph
          Section
          Code                              ; a fence; Mermaid is a figure
          List.Vector<Block>
          Quote.Vector<Block>
          Table.Vector<Row> ]
  Row.Vector<Text>
  Title.Text                                ; a heading's words
  Language.[ Ethos Datom Rust Nix Shell Ini Toml Mermaid Plain ]
  Text.Vector<Run>                          ; inside a paragraph
  Run.[ Words.String
        Emphasis.Text
        Strong.Text
        Code.String
        Reference ]                         ; a link
  Code.{ Language Text }
  Reference.{ Text Target }
  Target.[ Place Url.String ]
  Place.Vector<Text>                        ; the titles above a block, from the root
  Depth.Integer
  Outline.{ Title Vector<Outline> }
  Kind.[ Headings Statements Code References ]
  Pattern.String
  Edit.[ Insert.{ Place Block }
         Replace.{ Place Old.Block New.Block }
         Remove.{ Place Block } ]
  EditRefusal.[ NoSuchPlace.Place           ; why an edit is refused: no block at the place,
                Mismatch.{ Place            ;   or the block found is not the one expected
                           Expected.Block
                           Found.Block } ] ]
; what is asked of a document
[ Structural.[ outline.{ [ Depth ] [ Vector<Outline> ] } ; the headings, to a depth: one per top-level section
               code.{ [ Place ] [ Vector<Code> ] }         ; the code blocks under a section
               references.{ [ Place ] [ Vector<Reference> ] }
               search.{ [ Kind Pattern ] [ Vector<Place> ] } ; a string search over one kind
               edit!{ [ Edit ] [ Result<Document EditRefusal> ] } ] ]
[ Document.[ Structural ] ]
